<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CursivisCompanionSetup</AssemblyName>
    <RootNamespace>Cursivis.Setup</RootNamespace>
    <Version>1.5.1</Version>
    <Authors>Tanush Shah</Authors>
    <Product>Cursivis Companion Setup</Product>
    <Description>One-click setup for the Cursivis Companion runtime.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(CursivisRuntimeSha256)' != ''">
    <AssemblyMetadata Include="CursivisRuntimeSha256" Value="$(CursivisRuntimeSha256)" />
  </ItemGroup>

  <ItemGroup Condition="'$(CursivisRuntimeUrl)' != ''">
    <AssemblyMetadata Include="CursivisRuntimeUrl" Value="$(CursivisRuntimeUrl)" />
  </ItemGroup>

</Project>
